  "net/fabricmc/fabric/api/client/rendering/v1/BlockRenderLayerMap.putFluid(Lnet/minecraft/class_3611;Lnet/minecraft/class_11515;)V": "top/dext/centurybridge/step/v26_1/rt/CbFapiFluids",
